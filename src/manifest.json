{
	"manifest_version": 3,
	"name": "MiniMax: An NYT Crossword Add-on",
	"version": "3.0.1",
	"icons": {
		"64": "icons/logo64.png",
		"128": "icons/logo128.png"
	},
	"description": "Add-on to increase font size for NYT Crossword Games, easier navigation, and other QOL improvements.",
	"permissions": [
    	"storage",
		"webRequest"
  	],
	"host_permissions": [
		"*://*.nytimes.com/*"
	],
	"action": {
		"default_popup": "popup/main.html",
		"default_icon": "icons/logo128.png",
		"default_title": "MiniMax"
	},
	"content_scripts": [
   		{
			"js": ["scripts/gameContent.js"],
			"css": ["styles/gameContentStyles.css"],
			"matches": [
				"https://www.nytimes.com/crosswords/game/mini*",
				"https://www.nytimes.com/crosswords/game/midi*"
			]
		},
		{
			"js": ["scripts/archiveContent.js"],
			"matches": [
				"https://www.nytimes.com/crosswords/archive/mini*",
				"https://www.nytimes.com/crosswords/archive/midi*"
			]
		}
  	],
	"background": {
		"service_worker": "scripts/serviceWorker.js"
	}

}
