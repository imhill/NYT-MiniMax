{
	"manifest_version": 3,
	"name": "NYT MiniMax",
	"version": "1.1",
	"description": "Increase font size for NYT Mini Crossword and other improvements.",
	"action": {
		"default_popup": "popup/main.html",
		"default_icon": "icons/logo.png",
		"default_title": "NYT MiniMax"
	},
	"content_scripts": [
   		{
      			"js": ["scripts/content.js"],
      			"matches": [
        			"https://www.nytimes.com/crosswords/game/mini*"
      			]
    		}
  	]
}
